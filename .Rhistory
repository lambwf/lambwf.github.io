library(knitr)
library(tidyverse)
library(openxlsx)
library(RefManageR)
knitr::opts_chunk$set(echo=FALSE)
Sys.setlocale("LC_TIME", "C")
content <- read.xlsx("content.xlsx")
for (i in 1:length(content$title)) {
title <- content$title[i]
plot <- paste0("plots/", content$plot[i])
link <- content$link[i]
hover_text <- content$hover_text[i]
cat(paste0("<div class='figure-container'>"))
cat(paste0("<a href='", link, "' style='display: block; text-decoration: none;'>"))
cat(paste0("<div class='figure-hover-grey'></div>"))
cat(paste0("<div class='figure-hover-text'>", hover_text, "</div>"))
cat(paste0("<div class='figure-text'>", title, "</div>"))
cat(paste0("<img src='", plot, "' />"))
cat("</a>")
cat("</div>")
}
cat("<div class='text-container'>")
cat("<h1>Selected outreach</h1>")
outreach <- read.xlsx("outreach.xlsx", detectDates = TRUE)
outreach <- outreach %>%
arrange(desc(date)) %>%
mutate(year = format(date, "%Y")) %>%
group_by(year)
unique_years <- unique(outreach$year)
for (i in 1:length(unique_years)) {
cat(paste0("<p><strong>", unique_years[i], "</strong></p>\n"))
year_group <- outreach %>%
filter(year == unique_years[i])
for (j in 1:nrow(year_group)) {
formatted_date <- format(year_group$date[j], "%d/%m")
cat(paste0("<p>", year_group$text[j]," (", formatted_date, ")"))
if (!is.na(year_group$link[j])==TRUE) {
cat(paste0(" [<a href='",year_group$link[j],"' target='_blank' style='text-decoration: none;'>link</a>]"))
}
if (!is.na(year_group$photo[j])==TRUE) {
link = paste0("https://raw.githubusercontent.com/lambwf/lambwf.github.io/refs/heads/master/plots/",year_group$photo[j])
cat(paste0(" [<a href='",link,"' target='_blank' style='text-decoration: none;'>photo!</a>]"))
}
cat(paste0("</p>\n"))
}
}
View(year_group)
year_group <- outreach %>%
filter(year == 2004)
year_group <- outreach %>%
filter(year == unique_years[2])
View(year_group)
