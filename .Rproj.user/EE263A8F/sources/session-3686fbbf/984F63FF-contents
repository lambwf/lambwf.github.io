```{r load_g20_data}


## Load data from the NDC sheets

sheets <- data.frame(iso=c("EU27","GBR","IND","AUS","CHN","MEX","ZAF","TUR")) %>% 
  mutate(country=countrycode(iso,"iso3c","country.name")) %>% 
  mutate(country=ifelse(iso=="EU27","European Union",country))

data_g20 <- data_frame()

for (i in 1:length(sheets$iso)) {
  
  data <- read.xlsx("g20_NDCs_LULUCF.xlsx",sheets$iso[i],rows = 5:22)
  data <- data %>% 
    mutate(iso=sheets$iso[i]) %>% 
    mutate(country=sheets$country[i]) %>% 
    select(iso,country,everything()) %>%
    mutate(Source=as.character(Source))
  
  data_g20 <- data_g20 %>% 
    bind_rows(.,data)
  
}

data_g20 <- data_g20 %>% 
  gather(year,value,`2000`:`2050`) %>% 
  arrange(iso,year) %>% 
  mutate(year=as.numeric(year))

## Load data from the LT-LEDS sheets

data_lts <- read.xlsx("cdr_gap_assessment.xlsx",sheet="data_ltleds")
data_lts <- data_lts %>% 
  select(-Country) %>% 
  left_join(sheets,.,by=join_by(iso==ISO)) %>% 
  mutate(Scenario="Long-term strategy") %>%
  gather(.,Sector,value,`Novel.CDR.(MtCO2e)`,`LULUCF.(MtCO2e)`) %>% 
  mutate(value=-value) %>% 
  mutate(Sector=ifelse(grepl("LULUCF",Sector),"LULUCF","Novel CDR")) %>% 
  mutate(Source="LT-LEDS") %>% 
  mutate(Subsector=ifelse(Sector=="LULUCF","net",NA)) %>% 
  mutate(year=2050) %>% 
  select(iso,country,Scenario,Sector,Source,Subsector,year,value)


data_g20 <- data_g20 %>% 
  bind_rows(.,data_lts)

```


```{r g20_plots,fig.height = 4,fig.width=8}

data_g20_plots <- data_g20

p <- vector("list", length(sheets$iso))

for (i in 1:length(sheets$iso)) {
  
  
  summary <- data_g20_plots %>% 
    filter(iso==sheets$iso[i]) %>% 
  
  
  plot <- data_g20_plots %>% 
    filter(iso==sheets$iso[i]) %>% 
    filter(Sector=="LULUCF" & Subsector=="net") %>%
    ggplot(.,aes(x=year,y=value,group=Scenario,colour=Scenario)) +
      geom_hline(yintercept=0,colour="#939393") +
      geom_path(na.rm = TRUE) +
      geom_point(na.rm = TRUE) +
      theme_wl() +
      #scale_colour_manual(values=colours_9_qual) +
      scale_y_continuous(limits = c(NA, 0)) +
      theme(axis.title = element_blank()) +
      labs(title=sheets$country[i],subtitle=bquote(paste("Land use change (LULUCF) sector, MtCO"[2],"/year")))
  
  
  ggsave(plot,filename = paste0("SoCDR-NDC-Assessment-",sheets$country[i],".png"),path = "results/",device = "png",height = 4,width=8,dpi=300)
  ggsave(plot,filename = paste0("SoCDR-NDC-Assessment-",sheets$country[i],".pdf"),path = "results/",device = cairo_pdf,height = 4,width=8)
  ggsave(plot,filename = paste0("SoCDR-NDC-Assessment-",sheets$country[i],".svg"),path = "results/",device = 'svg',height = 4,width=8)

}


