```{r g20_table_lulucf}

## Get current LULUCF baseline


data_g20_table_lulucf <- read.xlsx("g20_NDCs_LULUCF.xlsx",sheet=1,startRow=2) %>% 
  select(iso=ISO3,country=Country,lulucf=LULUCF,removals=Net.removals) %>% 
  distinct() %>% 
  mutate(country=countrycode(iso,"iso3c","country.name")) %>% 
  mutate(country=ifelse(iso=="EU27","European Union",country)) %>% 
  arrange(country) %>% 
  mutate(lulucf=round(lulucf),removals=round(removals))

write.xlsx(data_g20_table_lulucf,"blarg.xlsx")


## get additional LULUCF removals in 2030, 2035 compared to baseline

data_g20_table_lulucf_change <- data_g20 %>% 
  filter(Sector=="LULUCF") %>% 
  filter(Subsector=="additional removals") %>% 
  filter(grepl("Target",Scenario)) %>% 
  filter(year %in% c(2030,2035)) %>% 
  filter(!is.na(value)) %>% 
  group_by(country,year) %>% 
  summarise(change=paste0(max(round(value))," to ",min(round(value))))


## get additional LULUCF removals in 2050 compared to baseline (but not using these actually)

data_g20_table_lulucf_lts <- data_lts %>% 
  filter(Sector=="LULUCF") %>% 
  left_join(.,data_g20_table_lulucf %>% select(iso,removals)) %>% 
  mutate(change=value-removals) %>% 
  group_by(country) %>% 
  mutate(summary=paste0(max(round(change))," to ",min(round(change))))


## get novel
data_g20_table_novel <- data_g20 %>% 
  filter(Sector=="Novel CDR") %>% 
  filter(Subsector=="additional removals") %>% 
  filter(grepl("Target",Scenario)) %>% 
  filter(year %in% c(2030,2035)) %>% 
  filter(!is.na(value)) %>% 
  group_by(country,year) %>% 
  summarise(change=paste0(max(round(value))," to ",min(round(value))))



